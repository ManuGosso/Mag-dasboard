# Copiar este archivo a ".env" y ajustar segun el entorno.

# Base de datos: por defecto SQLite (no requiere instalar nada).
# Para Postgres usar algo como:
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/mag_dashboard
DATABASE_URL=sqlite:///./data/mag_dashboard.db

# Categoria usada como "ternero de compra" en los KPIs principales
KPI_CATEGORIA_TERNERO=Terneros

# Categoria usada como "novillo de venta" en los KPIs principales
KPI_CATEGORIA_NOVILLO=Novillos +430 kg

# Origen de datos para el scraper (no modificar salvo que cambie el sitio del MAG)
MAG_BASE_URL=https://www.mercadoagroganadero.com.ar

# Nivel de tolerancia del semaforo (en % respecto al promedio 12 meses)
SEMAFORO_UMBRAL_BAJO=-8
SEMAFORO_UMBRAL_ALTO=8

# CORS: origenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
